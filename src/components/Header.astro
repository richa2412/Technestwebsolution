---
let isOpen = false;
---

<header class="w-full fixed top-0 left-0 z-50 shadow-lg shadow-white/10 bg-[#000336]">
  <div class="max-w-8xl mx-auto px-6 lg:px-20 py-3 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <img 
        src="img/logo.png" 
        alt="Technest Web Solution"
        class="h-16 w-auto object-contain"
      />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-10 text-white text-md font-medium">
      <a href="#services" class="hover:text-gray-300 transition">Services</a>
      <a href="#about" class="hover:text-gray-300 transition">About</a>
      <a href="#work" class="hover:text-gray-300 transition">Our Work</a>
      <a href="#technologies" class="hover:text-gray-300 transition">Technologies</a>
      <a href="#career" class="hover:text-gray-300 transition">Career</a>
    </nav>

    <!-- Desktop Button -->
    <a
      href="#contact"
      class="hidden md:block bg-white text-black text-sm font-medium px-5 py-2 rounded-lg shadow hover:bg-gray-200 transition"
    >
      Get a Free Quote
    </a>

    <!-- Mobile Menu Button -->
    <button 
      class="md:hidden text-white text-3xl"
      onclick="document.getElementById('mobileMenu').classList.toggle('hidden')"
    >
      ☰
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobileMenu" class="hidden bg-[#000336] md:hidden px-6 pb-5">
    <nav class="flex flex-col gap-4 text-white text-lg">
      <a href="#services" class="hover:text-gray-300">Services</a>
      <a href="#about" class="hover:text-gray-300">About</a>
      <a href="#work" class="hover:text-gray-300">Our Work</a>
      <a href="#technologies" class="hover:text-gray-300">Technologies</a>
      <a href="#career" class="hover:text-gray-300">Career</a>
      <a href="#contact" class="bg-white text-black text-center py-2 rounded-lg">
        Get a Free Quote
      </a>
    </nav>
  </div>
</header>
